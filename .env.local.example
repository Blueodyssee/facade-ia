# OpenRouter API Key (requis) — https://openrouter.ai/keys
# Utilisée pour l'analyse (Claude vision) ET le recoloriage (Gemini image)
OPENROUTER_API_KEY=sk-or-...

# Mot de passe d'accès au site (HTTP Basic Auth). Défaut : web
# APP_PASSWORD=web

# Optionnel : forcer un modèle de recoloriage
# Qualité (défaut) : google/gemini-3-pro-image-preview (~7× plus cher, plus fidèle)
# Économique      : google/gemini-2.5-flash-image
# RECOLOR_MODEL=google/gemini-3-pro-image-preview

# Optionnel : compteur global de simulations (Upstash Redis REST)
# UPSTASH_REDIS_REST_URL=https://....upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
